{
  "name": "open-guess",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "preview": "node scripts/serve.mjs",
    "assets": "node scripts/assets.mjs",
    "format": "prettier --write App.tsx src tests scripts"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.12",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-media-library": "~58.0.11",
    "expo-screen-orientation": "~58.0.3",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
